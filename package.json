{
  "name": "penpot-slides-plugin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && node scripts/check-plugin-bundle.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node e2e/run.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@penpot/plugin-styles": "1.4.2",
    "@penpot/plugin-types": "1.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.5",
    "vite-live-preview": "^0.3.2",
    "vitest": "^4.1.12"
  }
}
